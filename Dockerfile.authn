ARG GO_VERSION=1.27.4
ARG NODE_VERSION=24

# Stage 1: Build the Go binary
FROM golang:${GO_VERSION}-alpine AS builder

WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o authn ./cmd/authn

# Stage 2: Build the WebUI
FROM node:${NODE_VERSION}-alpine AS webui-builder

WORKDIR /webui

COPY webui/package.json webui/pnpm-lock.yaml webui/pnpm-workspace.yaml ./
RUN corepack enable pnpm && pnpm install --frozen-lockfile

COPY webui/ ./
RUN pnpm run build

# Stage 3: Create a minimal runtime image
FROM alpine:latest AS deploy

WORKDIR /app

# Install ca-certificates for SSL/TLS support
RUN apk update && apk add --no-cache ca-certificates

# Copy the binary and WebUI assets from the builder stages
COPY --from=builder /app/authn .
COPY --from=webui-builder /webui/dist ./webui

# Command to run the executable
CMD ["./authn"]
