{
	authn_yaml_file /path/to/authn.config.yaml
	order paw_waf before basic_auth
	order paw_auth before basic_auth
}

auth.example.com:8443 {
	reverse_proxy 127.0.0.1:8081
}

# Standalone WAF protecting an upstream service
open.example.com:8443 {
	paw_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			SecRuleEngine On
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRule ARGS:admin "@streq 1" "id:1001,phase:2,deny,status:403"
		`
	}

	reverse_proxy 127.0.0.1:8082
}

app1.example.com:8443 {
	paw_auth {
		basic_auth
		client_id client_id
		client_secret client_secret
		roles admin
		waf {
			load_owasp_crs
			directives `
				Include @coraza.conf-recommended
				SecRuleEngine On
				Include @crs-setup.conf.example
				Include @owasp_crs/*.conf
			`
		}
	}

	handle / {
		respond "Hi, This is app1" 200
	}
}

app2.example.com:8443 {
	paw_auth {
		server_cookies
		client_id client_id
		client_secret client_secret
		callback_url https://app2.example.com/paw/callback
		roles admin
		waf {
			directives `
				SecRuleEngine On
				SecRule ARGS:attack "@streq 1" "id:2001,phase:2,deny,status:403"
			`
		}
	}

	respond "Hi, This is app2" 200
}

app3.example.com:8443 {
	paw_auth {
		bearer_token
		token test-token
	}

	respond "Hi, This is app3" 200
}
