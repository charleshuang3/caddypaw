{
	authn_yaml_file /path/to/authn.config.yaml
	order paw_waf before basic_auth
	order paw_auth before basic_auth
}

auth.example.com:8443 {
	reverse_proxy 127.0.0.1:8081
}

# Standalone WAF protecting an upstream service
open.example.com:8443 {
	paw_waf {
		preset default
	}

	reverse_proxy 127.0.0.1:8082
}

app1.example.com:8443 {
	paw_auth {
		basic_auth
		client_id client_id
		client_secret client_secret
		roles admin
		waf {
			preset default
		}
	}

	handle / {
		respond "Hi, This is app1" 200
	}
}

app2.example.com:8443 {
	paw_auth {
		server_cookies
		client_id client_id
		client_secret client_secret
		callback_url https://app2.example.com/paw/callback
		roles admin
		waf {
			directives `
				SecRuleEngine On
				SecRule ARGS:attack "@streq 1" "id:2001,phase:2,deny,status:403"
			`
		}
	}

	respond "Hi, This is app2" 200
}

app3.example.com:8443 {
	paw_auth {
		bearer_token
		token test-token
	}

	respond "Hi, This is app3" 200
}

# WebDAV behind basic auth. Generic CRS rules misfire on PROPFIND/PUT payloads,
# so authenticated traffic is inspected in detection-only mode: every match is
# still logged and reported to /logerr, but nothing is blocked. Unauthenticated
# traffic that trips a rule is also reported (the ban pipeline stays fed) while
# still receiving its 401 challenge, and public_urls keep blocking.
dav.example.com:8443 {
	paw_auth {
		basic_auth
		client_id webdav
		client_secret client_secret
		roles admin
		waf {
			preset default
			after_auth detect_only
		}
	}

	# The WebDAV server itself, running on the same host.
	reverse_proxy 127.0.0.1:8081
}
